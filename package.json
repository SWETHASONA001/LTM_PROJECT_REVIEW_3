{
  "name": "aerohydro-pinn",
  "private": true,
  "description": "Runs the AeroHydro-PINN backend and frontend together. The app code lives in frontend/ and backend/.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "frontend": "npm --prefix frontend run dev",
    "backend": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test"
  }
}
